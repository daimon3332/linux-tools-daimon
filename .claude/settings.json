{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-push.sh\"",
            "timeout": 120,
            "statusMessage": "Auto-pushing linux-toolbox.sh..."
          }
        ]
      }
    ]
  }
}
